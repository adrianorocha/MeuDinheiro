<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!-- R64: captura de notificações do banco só neste aparelho -->
        <exclude domain="file" path="captura_sugestoes.json" />
        <exclude domain="sharedpref" path="captura_notificacoes.xml" />
        <exclude domain="sharedpref" path="categorias_aprendidas.xml" />
        <exclude domain="sharedpref" path="lembretes_vencimento.xml" />
        <exclude domain="sharedpref" path="push_dispositivo.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="captura_sugestoes.json" />
        <exclude domain="sharedpref" path="captura_notificacoes.xml" />
        <exclude domain="sharedpref" path="categorias_aprendidas.xml" />
        <exclude domain="sharedpref" path="lembretes_vencimento.xml" />
        <exclude domain="sharedpref" path="push_dispositivo.xml" />
    </device-transfer>
</data-extraction-rules>